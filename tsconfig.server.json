{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    // DOM 仅为 tests/ 下的 .drawio 导入解析测试提供 DOMParser 类型，服务端代码不应使用 DOM API
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["server/**/*.ts", "api/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
